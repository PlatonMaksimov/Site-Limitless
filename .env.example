# Copy to a private server-only environment file. Never place it inside dist/.
PORT=4180
SITE_ORIGIN=http://127.0.0.1:4180
DATABASE_PATH=./data/limitless.sqlite
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID, not username. /id reveals your own ID only.
TELEGRAM_OWNER_ID=
# Production requires HTTPS + a REAL same-origin privacy document + its version.
PRIVACY_URL=
PRIVACY_VERSION=
LEADS_ENABLED=false
TRUST_PROXY=false
RETENTION_DAYS=30
MAX_PENDING_DELIVERIES=5000
LEAD_RATE_LIMIT=5
